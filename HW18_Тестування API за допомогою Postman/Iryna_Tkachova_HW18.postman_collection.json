	"item": [
		{
			"name": "CREATE user - Successful",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Отримуємо JSON з відповіді\r",
							"let response = pm.response.json();\r",
							"\r",
							"// Зберігаємо значення у змінну колекції\r",
							"pm.collectionVariables.set(\"id\", response.id);\r",
							"// Перевіримо в консолі\r",
							"console.log(\"Id saved:\", response.id);\r",
							"\r",
							"// Тестування відповіді\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response body contains correct data\", function () {\r",
							"    pm.expect(response).to.have.property(\"id\");\r",
							"    pm.expect(response).to.have.property(\"name\");\r",
							"    pm.expect(response).to.have.property(\"age\");\r",
							"    pm.expect(response).to.have.property(\"gender\");\r",
							"    pm.expect(response).to.have.property(\"city\");\r",
							"\r",
							"    pm.expect(response.id).to.be.a('string');\r",
							"    pm.expect(response.name).to.be.a('string');\r",
							"    pm.expect(response.city).to.be.a('string');\r",
							"    pm.expect(response.age).to.be.a('number');\r",
							"    pm.expect(response.gender).to.be.a('string');\r",
							"});    \r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"name\":\"Andrii\",\r\n\"age\":\"37\",\r\n\"gender\":\"male\",\r\n\"city\":\"Kyiv\"\r\n}\r\n",
					"options": {
